                            <span class="news-date">📅 Mar 10, 2026</span>
                            <a href="#" class="btn-read">Read more →</a>
                        </div>
                    </div>
                </div>

                <!-- News Item 9 -->
                <div class="news-card" data-category="Education" data-title="international exchange program">
                    <div class="news-image">Article Image</div>
                    <div class="news-body">
                        <span class="news-category">Education</span>
                        <h3 class="news-title">International Exchange Program Expansion</h3>
                        <p class="news-excerpt">New partnerships with universities worldwide enable FPT students to study and gain experience globally.</p>
                        <div class="news-footer">
                            <span class="news-date">📅 Mar 9, 2026</span>
                            <a href="#" class="btn-read">Read more →</a>
